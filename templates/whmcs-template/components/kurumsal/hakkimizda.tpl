<div class="ixir-cert-modal" id="ixirCertModal" hidden>
 <button type="button" class="ixir-cert-modal-close" aria-label="Kapat">&times;</button>
 <img id="ixirCertModalImg" alt="Sertifika görseli">
</div>

<script>
 {literal}
  (function() {
   var modal = document.getElementById('ixirCertModal');
   var img = document.getElementById('ixirCertModalImg');
   var wrap = document.getElementById('ixirCerts');
   if (!modal || !img || !wrap) {
    return;
   }

   function openModal(src, alt) {
    img.src = src;
    img.alt = alt || 'Sertifika görseli';
    modal.hidden = false;
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
   }

   function closeModal() {
    modal.classList.remove('is-open');
    modal.hidden = true;
    img.removeAttribute('src');
    document.body.style.overflow = '';
   }
   wrap.addEventListener('click', function(e) {
    var btn = e.target.closest('button[data-full]');
    if (!btn) {
     return;
    }
    openModal(btn.getAttribute('data-full'), btn.getAttribute('aria-label'));
   });
   modal.addEventListener('click', function(e) {
    if (e.target === modal || e.target.classList.contains('ixir-cert-modal-close')) {
     closeModal();
    }
   });
   document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) {
     closeModal();
    }
   });
  })();
 {/literal}
</script>