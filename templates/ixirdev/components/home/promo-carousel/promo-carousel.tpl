<section class="ixir-promo ixir-slide ixir-slide--left is-slide-on" id="ixirPromo" aria-roledescription="carousel"
  aria-label="Öne çıkan hizmetler">
  <div class="ixir-promo-viewport">
    {foreach $promoSlides as $slide}
      <article class="ixir-promo-slide{if $slide@first} is-active{/if}" data-theme="{$slide.theme}" aria-hidden="{if $slide@first}false{else}true{/if}">
        <div class="container">
          <div class="ixir-promo-grid">
            <div class="ixir-promo-copy">
              <span class="ixir-promo-badge"><i class="{$slide.icon}" aria-hidden="true"></i> {$slide.badge}</span>
              <h2>{$slide.title}</h2>
              <p>{$slide.desc}</p>
              <ul>
                {foreach $slide.features as $feature}
                  <li><i class="fas fa-check" aria-hidden="true"></i>{$feature}</li>
                {/foreach}
              </ul>
              <a href="{$WEB_ROOT}{$slide.link}" class="ixir-promo-btn">İncele <i class="fas fa-arrow-right"
                  aria-hidden="true"></i></a>
            </div>
            <div class="ixir-promo-visual">
              <img src="{$WEB_ROOT}/templates/{$template}/{$slide.image}" alt="{$slide.title}">
            </div>
          </div>
        </div>
      </article>
    {/foreach}
  </div>
  <button type="button" class="ixir-promo-nav ixir-promo-prev" aria-label="Önceki slayt">
    <i class="fas fa-chevron-left" aria-hidden="true"></i>
  </button>
  <button type="button" class="ixir-promo-nav ixir-promo-next" aria-label="Sonraki slayt">
    <i class="fas fa-chevron-right" aria-hidden="true"></i>
  </button>
  <div class="ixir-promo-dots" role="tablist" aria-label="Slayt seçimi"></div>
</section>

<script>
  {literal}
  jQuery(function($) {
    (function initIxirPromo() {
      var root = document.getElementById('ixirPromo');
      if (!root) {
        return;
      }
      var viewport = root.querySelector('.ixir-promo-viewport');
      var slides = Array.prototype.slice.call(root.querySelectorAll('.ixir-promo-slide'));
      var dotsWrap = root.querySelector('.ixir-promo-dots');
      var prev = root.querySelector('.ixir-promo-prev');
      var next = root.querySelector('.ixir-promo-next');
      if (!viewport || slides.length < 2 || !dotsWrap) {
        return;
      }
      var index = 0;
      var timer = null;
      var hovering = false;
      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var interval = 5500;
      var startX = 0;
      var deltaX = 0;
      var dragging = false;

      var animating = false;
      var animMs = reduceMotion ? 0 : 900;

      slides.forEach(function(_, i) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('role', 'tab');
        btn.setAttribute('aria-label', 'Slayt ' + (i + 1));
        btn.addEventListener('click', function() {
          go(i, true);
        });
        dotsWrap.appendChild(btn);
      });
      var dots = Array.prototype.slice.call(dotsWrap.children);

      function clearAnim(slide) {
        slide.classList.remove(
          'is-animating',
          'is-no-anim',
          'is-from-next',
          'is-from-prev',
          'is-leave-next',
          'is-leave-prev'
        );
      }

      function go(nextIndex, user, dir) {
        var target = (nextIndex + slides.length) % slides.length;
        if (target === index || animating) {
          return;
        }
        if (!dir) {
          var forward = (target - index + slides.length) % slides.length;
          dir = forward <= slides.length / 2 ? 1 : -1;
        }
        var outgoing = slides[index];
        var incoming = slides[target];
        index = target;

        dots.forEach(function(dot, i) {
          var on = i === index;
          dot.classList.toggle('is-active', on);
          dot.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        slides.forEach(function(slide, i) {
          slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
        });

        if (reduceMotion) {
          slides.forEach(function(slide, i) {
            clearAnim(slide);
            slide.classList.toggle('is-active', i === index);
          });
          if (user) {
            restart();
          }
          return;
        }

        animating = true;
        viewport.style.height = viewport.offsetHeight + 'px';
        clearAnim(incoming);
        incoming.classList.add('is-no-anim', 'is-animating', dir > 0 ? 'is-from-next' : 'is-from-prev');
        incoming.offsetWidth;
        incoming.classList.remove('is-no-anim');
        incoming.classList.add('is-active');
        incoming.classList.remove('is-from-next', 'is-from-prev');

        outgoing.classList.add('is-animating', dir > 0 ? 'is-leave-next' : 'is-leave-prev');
        outgoing.classList.remove('is-active');

        window.setTimeout(function() {
          clearAnim(outgoing);
          clearAnim(incoming);
          incoming.classList.add('is-active');
          viewport.style.height = '';
          animating = false;
        }, animMs);

        if (user) {
          restart();
        }
      }

      function restart() {
        window.clearInterval(timer);
        timer = null;
        if (reduceMotion || hovering || document.hidden) {
          return;
        }
        timer = window.setInterval(function() {
          go(index + 1, false, 1);
        }, interval);
      }

      function onPointerDown(e) {
        if (e.pointerType === 'mouse' && e.button !== 0) {
          return;
        }
        if (e.target.closest('a, button')) {
          return;
        }
        dragging = true;
        startX = e.clientX;
        deltaX = 0;
      }

      function onPointerMove(e) {
        if (!dragging) {
          return;
        }
        deltaX = e.clientX - startX;
      }

      function onPointerUp() {
        if (!dragging) {
          return;
        }
        dragging = false;
        if (Math.abs(deltaX) > 50) {
          go(index + (deltaX < 0 ? 1 : -1), true, deltaX < 0 ? 1 : -1);
        }
      }

      prev.addEventListener('click', function() {
        go(index - 1, true, -1);
      });
      next.addEventListener('click', function() {
        go(index + 1, true, 1);
      });
      root.addEventListener('mouseenter', function() {
        hovering = true;
        restart();
      });
      root.addEventListener('mouseleave', function() {
        hovering = false;
        restart();
      });
      root.addEventListener('focusin', function() {
        hovering = true;
        restart();
      });
      root.addEventListener('focusout', function(e) {
        if (!root.contains(e.relatedTarget)) {
          hovering = false;
          restart();
        }
      });
      viewport.addEventListener('pointerdown', onPointerDown);
      viewport.addEventListener('pointermove', onPointerMove);
      viewport.addEventListener('pointerup', onPointerUp);
      viewport.addEventListener('pointercancel', onPointerUp);
      document.addEventListener('visibilitychange', restart);
      root.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          go(index - 1, true, -1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          go(index + 1, true, 1);
        }
      });
      dots[0].classList.add('is-active');
      dots[0].setAttribute('aria-selected', 'true');

      var heightMq = window.matchMedia('(max-width: 768px)');
      var heightTimer = null;

      function syncSlideHeight() {
        if (!heightMq.matches) {
          slides.forEach(function(slide) {
            slide.style.minHeight = '';
          });
          return;
        }
        var max = 0;
        var width = viewport.clientWidth;
        slides.forEach(function(slide) {
          var clone = slide.cloneNode(true);
          clone.setAttribute('aria-hidden', 'true');
          clone.classList.add('is-active');
          clone.style.position = 'absolute';
          clone.style.visibility = 'hidden';
          clone.style.pointerEvents = 'none';
          clone.style.opacity = '0';
          clone.style.height = 'auto';
