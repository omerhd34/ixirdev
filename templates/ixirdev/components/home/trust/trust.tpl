<section class="ixir-trust" id="ixir-trust" aria-labelledby="ixir-trust-title">
 <div class="container">
  <header class="ixir-trust-head">
   <div class="ixir-trust-badge"><i class="fas fa-handshake" aria-hidden="true"></i> GÜVENLİ ALTYAPI</div>
   {include file="$template/components/Heading.tpl" title="20 Yıllık Tecrübe, Türkiye'nin Tercihi" id="ixir-trust-title" tag="h2"}
   <p>Güçlü altyapımız, 20 yıllık sektör deneyimimiz ve müşteri odaklı hizmet anlayışımızla web sitelerinizin, sunucularınızın ve dijital projelerinizin ihtiyaç duyduğu desteği sunuyoruz. Güvenilir teknoloji çözümlerimiz ve uzman ekibimizle projelerinizin her aşamasında yanınızdayız.</p>
  </header>

  <div class="ixir-trust-proof">
   <div class="ixir-trust-map">
    <picture>
     <source srcset="{$WEB_ROOT}/templates/{$template}/img/turkey-stats/turkey-map.webp" type="image/webp">
     <img src="{$WEB_ROOT}/templates/{$template}/img/turkey-stats/turkey-map.jpg" alt="Türkiye haritası" width="3600"
      height="1500" decoding="async">
    </picture>
    <p>Türkiye'nin dört bir yanındaki projelere güç veriyoruz.</p>
   </div>
   <ul class="ixir-trust-metrics" aria-label="İXİRHOST hizmet istatistikleri">
    <li class="ixir-trust-metric">
     <span class="ixir-trust-metric-icon" aria-hidden="true"><i class="fas fa-users"></i></span>
     <strong data-to="22000" data-suffix="+">22.000+</strong>
     <span>Müşteri</span>
    </li>
    <li class="ixir-trust-metric">
     <span class="ixir-trust-metric-icon" aria-hidden="true"><i class="fas fa-globe"></i></span>
     <strong data-to="10000" data-suffix="+">10.000+</strong>
     <span>Web Sitesi</span>
    </li>
    <li class="ixir-trust-metric">
     <span class="ixir-trust-metric-icon" aria-hidden="true"><i class="fas fa-layer-group"></i></span>
     <strong data-to="20000" data-suffix="+">20.000+</strong>
     <span>Domain</span>
    </li>
    <li class="ixir-trust-metric">
     <span class="ixir-trust-metric-icon" aria-hidden="true"><i class="fas fa-smile-beam"></i></span>
     <strong data-to="99.9" data-prefix="%" data-decimals="1">%99.9</strong>
     <span>Müşteri Memnuniyeti</span>
    </li>
   </ul>
  </div>

  <div class="ixir-trust-values">
   <div class="ixir-trust-grid">
    <article class="ixir-trust-item">
     <div class="ixir-trust-icon" aria-hidden="true">
      <img src="{$WEB_ROOT}/templates/{$template}/img/trust/customer.svg" alt="">
     </div>
     <h4>Müşteri Odaklı</h4>
     <p>Müşteri odaklı ürün ve iletişim stratejimiz sayesinde en iyi hizmeti alın.</p>
     <div class="ixir-trust-footer">
      <span class="ixir-trust-tag"><i class="fas fa-user-check" aria-hidden="true"></i> Öncelikli Destek</span>
     </div>
    </article>
    <article class="ixir-trust-item">
     <div class="ixir-trust-icon" aria-hidden="true">
      <img src="{$WEB_ROOT}/templates/{$template}/img/trust/sale.svg" alt="">
     </div>
     <h4>Yıl Boyu Ekonomik</h4>
     <p>Yıl boyu en ekonomik hosting fiyatları ile maliyetlerinizi düşürün.</p>
     <div class="ixir-trust-footer">
      <span class="ixir-trust-tag"><i class="fas fa-tags" aria-hidden="true"></i> Sabit Fiyat Garantisi</span>
     </div>
    </article>
    <article class="ixir-trust-item">
     <div class="ixir-trust-icon" aria-hidden="true">
      <img src="{$WEB_ROOT}/templates/{$template}/img/trust/api.svg" alt="">
     </div>
     <h4>Gelişmiş AR-GE</h4>
     <p>Ürün AR-GE çalışmalarımızla güncel teknolojiler ve yeni servisler sunuyoruz.</p>
     <div class="ixir-trust-footer">
      <span class="ixir-trust-tag"><i class="fas fa-microchip" aria-hidden="true"></i> Modern Altyapı</span>
     </div>
    </article>
    <article class="ixir-trust-item">
     <div class="ixir-trust-icon" aria-hidden="true">
      <img src="{$WEB_ROOT}/templates/{$template}/img/trust/money.svg" alt="">
     </div>
     <h4>Ücret İadesi</h4>
     <p>Linux Hosting paketlerimizi 15 gün koşulsuz iade imkânıyla deneyin.</p>
     <div class="ixir-trust-footer">
      <span class="ixir-trust-tag"><i class="fas fa-undo" aria-hidden="true"></i> 15 Gün Koşulsuz</span>
     </div>
    </article>
    <article class="ixir-trust-item">
     <div class="ixir-trust-icon" aria-hidden="true">
      <img src="{$WEB_ROOT}/templates/{$template}/img/trust/cog.svg" alt="">
     </div>
     <h4>Ücretsiz Servisler</h4>
     <p>Hosting, domain ve sunucu hizmetlerindeki ücretsiz servislerle ek maliyetleri azaltın.</p>
     <div class="ixir-trust-footer">
      <span class="ixir-trust-tag"><i class="fas fa-gift" aria-hidden="true"></i> Ekstra Maliyetsiz</span>
     </div>
    </article>
    <article class="ixir-trust-item">
     <div class="ixir-trust-icon" aria-hidden="true">
      <img src="{$WEB_ROOT}/templates/{$template}/img/trust/telephone.svg" alt="">
     </div>
     <h4>7/24/365 Destek</h4>
     <p>Çok kanallı destek ekibimize ihtiyaç duyduğunuz her an ulaşın.</p>
     <div class="ixir-trust-footer">
      <span class="ixir-trust-tag"><i class="fas fa-headset" aria-hidden="true"></i> Kesintisiz İletişim</span>
     </div>
    </article>
   </div>
  </div>
 </div>
</section>
<script>
 {literal}
  (function() {
   var root = document.getElementById('ixir-trust');
   if (!root || !window.IntersectionObserver ||
    (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
    return;
   }

   var values = root.querySelectorAll('.ixir-trust-metric strong[data-to]');

   function formatValue(number, decimals) {
    if (decimals) {
     return Number(number).toFixed(decimals);
    }
    return String(Math.round(number)).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
   }

   function paintValue(element, number) {
    var prefix = element.getAttribute('data-prefix') || '';
    var suffix = element.getAttribute('data-suffix') || '';
    var decimals = parseInt(element.getAttribute('data-decimals') || '0', 10);
    element.textContent = prefix + formatValue(number, decimals) + suffix;
   }

   function animateValues() {
    var duration = 1600;
    var start;

    function frame(timestamp) {
     if (start === undefined) {
      start = timestamp;
     }
     var progress = Math.min(1, (timestamp - start) / duration);
     var eased = 1 - Math.pow(1 - progress, 3);
     values.forEach(function(element) {
      paintValue(element, parseFloat(element.getAttribute('data-to')) * eased);
     });
     if (progress < 1) {
      window.requestAnimationFrame(frame);
      return;
     }
     values.forEach(function(element) {
      paintValue(element, parseFloat(element.getAttribute('data-to')));
     });
    }

    window.requestAnimationFrame(frame);
   }

   values.forEach(function(element) {
    paintValue(element, 0);
   });
   root.classList.add('is-armed');

   var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
     if (!entry.isIntersecting) {
      return;
     }
     observer.disconnect();
     window.requestAnimationFrame(function() {
      root.classList.add('is-in');
      window.setTimeout(animateValues, 160);
      window.setTimeout(function() {
       root.classList.remove('is-armed');
      }, 1400);
     });
    });
   }, {
    threshold: 0
   });
   observer.observe(root);
  })();
 {/literal}
</script>
