  <p class="ixir-km-cmp-note">1 USD = 49 TL - G Mail $7/kullanıcı - 365 Mail $6/kullanıcı - İXİRHOST fiyatları %30
   indirimli yıllık paket fiyatıdır.</p>
 </div>
 <script>
  {literal}
  (function() {
   var root = document.getElementById('ixir-km-cmp');
   if (!root) return;
   var input = root.querySelector('#ixir-km-cmp-users');
   var usd = parseFloat(root.getAttribute('data-usd')) || 49;
   var gPer = (parseFloat(root.getAttribute('data-gmail')) || 7) * usd;
   var mPer = (parseFloat(root.getAttribute('data-ms')) || 6) * usd;
   var tiers = [
    { max: 10, name: 'Budget Mail', price: 732.92 },
    { max: 30, name: 'Essential Mail', price: 1182.17 },
    { max: 100, name: 'Economy Mail', price: 1630.67 },
    { max: 300, name: 'Professional Mail', price: 3299.50 }
   ];
   var fmt = function(n) { return Math.round(n).toLocaleString('tr-TR'); };
   var set = function(key, val) {
    var el = root.querySelector('[data-km="' + key + '"]');
    if (el) el.textContent = val;
   };
   var width = function(key, pct) {
    var el = root.querySelector('[data-km="' + key + '"]');
    if (el) el.style.width = Math.max(pct, 1.5) + '%';
   };
   var update = function() {
    var users = parseInt(input.value, 10) || 1;
    var tier = tiers[tiers.length - 1];
    for (var i = 0; i < tiers.length; i++) {
     if (users <= tiers[i].max) { tier = tiers[i]; break; }
    }
    var us = tier.price;
    var g = gPer * users;
    var m = mPer * users;
    var top = Math.max(g, m, us);
    var min = parseInt(input.min, 10);
    var max = parseInt(input.max, 10);
    input.style.setProperty('--p', ((users - min) / (max - min)) * 100 + '%');
    set('users', users);
    set('ixir-total', fmt(us));
    set('ixir-per', fmt(us / users));
    set('ixir-plan', tier.name);
    set('gmail-total', fmt(g));
    set('gmail-per', fmt(gPer));
    set('ms-total', fmt(m));
    set('ms-per', fmt(mPer));
    set('gmail-save', fmt(Math.max(g - us, 0)));
    set('ms-save', fmt(Math.max(m - us, 0)));
    set('year-save', fmt(Math.max(g - us, m - us, 0) * 12));
    width('gmail-bar', (g / top) * 100);
    width('ms-bar', (m / top) * 100);
    width('gmail-bar-us', (us / top) * 100);
    width('ms-bar-us', (us / top) * 100);
   };
   input.addEventListener('input', update);
    update();
   })();
  {/literal}
 </script>
</section>