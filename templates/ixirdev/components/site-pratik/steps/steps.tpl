<section class="ixir-sp-steps ixir-slide ixir-slide--left is-slide-on" id="sitepratik-adimlar" aria-labelledby="ixir-sp-steps-title">
 <div class="container">
  <header class="ixir-sp-steps-head">
   <div class="ixir-badge-pill ixir-ssl-badge-pill"><i class="fas fa-shoe-prints" aria-hidden="true"></i> 3 ADIMDA YAYINLA</div>
   {include file="$template/components/Heading.tpl" title="Şimdi Üç Adımda Web Sitenizi Yayınlayın" id="ixir-sp-steps-title" align="center"}
   <p class="ixir-sp-steps-subtitle">Temanı seç, içeriklerini yaz ve web siteni dakikalar içerisinde yayınla! Teknik bilgi gerektirmez.</p>
  </header>

  <div class="ixir-sp-steps-grid">
   <article class="ixir-sp-step-card">
    <div class="ixir-sp-step-header">
     <span class="ixir-sp-step-num" aria-hidden="true">1</span>
     <h3 class="ixir-sp-step-title">Tasarımı Seçin</h3>
    </div>
    <div class="ixir-sp-step-visual">
     <img src="{$WEB_ROOT}/templates/{$template}/img/sitePratik/1.webp" alt="Tasarımı Seçin" loading="lazy">
    </div>
    <p class="ixir-sp-step-desc">Yüzlerce profesyonel hazır tasarım arasından dilediğinizi seçin.</p>
   </article>

   <article class="ixir-sp-step-card">
    <div class="ixir-sp-step-header">
     <span class="ixir-sp-step-num" aria-hidden="true">2</span>
     <h3 class="ixir-sp-step-title">İçeriklerinizi Girin</h3>
    </div>
    <div class="ixir-sp-step-visual">
     <img src="{$WEB_ROOT}/templates/{$template}/img/sitePratik/2.webp" alt="İçeriklerinizi Girin" loading="lazy">
    </div>
    <p class="ixir-sp-step-desc">Hazır içerikler üzerinden düzenleme yaparak kendi içeriklerinizi oluşturun.</p>
   </article>

   <article class="ixir-sp-step-card">
    <div class="ixir-sp-step-header">
     <span class="ixir-sp-step-num" aria-hidden="true">3</span>
     <h3 class="ixir-sp-step-title">Yayındasınız!</h3>
    </div>
    <div class="ixir-sp-step-visual">
     <img src="{$WEB_ROOT}/templates/{$template}/img/sitePratik/3.webp" alt="Yayındasınız!" loading="lazy">
    </div>
    <p class="ixir-sp-step-desc">Web sitenizi tek tıkla zahmetsizce yayınlayın ve ziyaretçi alın.</p>
   </article>
  </div>
 </div>
</section>
