<section class="ixir-ss-details ixir-slide ixir-slide--right is-slide-on" aria-labelledby="ixir-ss-details-title">
 <div class="container">
  <header class="ixir-wh-plans-head ixir-ss-details-head">
   {include file="$template/components/Heading.tpl" title="Co-Location Teknoloji Altyapımız" id="ixir-ss-details-title"}
  </header>

  <div class="ixir-ss-tab-container">
   <!-- Tab Buttons -->
   <div class="ixir-ss-tab-nav-wrapper">
    <div class="ixir-ss-tab-nav" role="tablist" aria-label="Sunucu Destek Özellikleri">
     <button type="button" class="ixir-ss-tab-btn is-active" role="tab" aria-selected="true" aria-controls="ixir-ss-pane-1" id="ixir-ss-tab-1" data-tab-target="1">
      <i class="fas fa-server" aria-hidden="true"></i>
      <span>Veri Merkezi</span>
     </button>
     <button type="button" class="ixir-ss-tab-btn" role="tab" aria-selected="false" aria-controls="ixir-ss-pane-2" id="ixir-ss-tab-2" data-tab-target="2">
      <i class="fas fa-bolt" aria-hidden="true"></i>
      <span>Elektrik Altyapısı</span>
     </button>
     <button type="button" class="ixir-ss-tab-btn" role="tab" aria-selected="false" aria-controls="ixir-ss-pane-3" id="ixir-ss-tab-3" data-tab-target="3">
      <i class="fas fa-network-wired" aria-hidden="true"></i>
      <span>İnternet Altyapısı</span>
     </button>
     <button type="button" class="ixir-ss-tab-btn" role="tab" aria-selected="false" aria-controls="ixir-ss-pane-4" id="ixir-ss-tab-4" data-tab-target="4">
      <i class="fas fa-snowflake" aria-hidden="true"></i>
      <span>UPS ve Soğutma Sistemleri</span>
     </button>
     <button type="button" class="ixir-ss-tab-btn" role="tab" aria-selected="false" aria-controls="ixir-ss-pane-5" id="ixir-ss-tab-5" data-tab-target="5">
      <i class="fas fa-shield-alt" aria-hidden="true"></i>
      <span>Yedekli Sistemler</span>
     </button>
    </div>
   </div>

   <!-- Tab Content Panels -->
   <div class="ixir-ss-tab-content">
    <!-- Panel 1 -->
    <div class="ixir-ss-pane is-active" role="tabpanel" id="ixir-ss-pane-1" aria-labelledby="ixir-ss-tab-1">
     <div class="ixir-ss-pane-card">
      <div class="ixir-ss-pane-icon">
       <i class="fas fa-server" aria-hidden="true"></i>
      </div>
      <h3 class="ixir-ss-pane-title">Veri Merkezi</h3>
      <p class="ixir-ss-pane-desc">İXİRHOST'un <strong>İstanbul lokasyonlu</strong> <strong>TIER III+ sertifikalı veri merkezi</strong>, yedek elektrik şebekesi ve yedek soğutma sistemleri içerir. <strong>TIER III+ veri merkezi</strong> standart olarak <strong>24 saatlik bir kesintiye karşı</strong> dayanabilir ve <strong>%99.9 oranında uptime garantisi</strong> sağlar.</p>
     </div>
    </div>

    <!-- Panel 2 -->
    <div class="ixir-ss-pane" role="tabpanel" id="ixir-ss-pane-2" aria-labelledby="ixir-ss-tab-2" hidden>
     <div class="ixir-ss-pane-card">
      <div class="ixir-ss-pane-icon">
       <i class="fas fa-bolt" aria-hidden="true"></i>
      </div>
      <h3 class="ixir-ss-pane-title">Elektrik Altyapısı</h3>
      <p class="ixir-ss-pane-desc">Elektrik altyapımız toplam <strong>3 mW'lık iki farklı trafodan</strong> alınmakta, her iki trafo <strong>ATS ile ölçülerek</strong> düşük voltaj durumunda trafolar arası geçişi <strong>otomatik</strong> sağlamaktadır. <strong>3 adet Caterpillar 1.100 KvA Jeneratör</strong>, <strong>2x3.5 Ton ve 10 Ton yakıt</strong> hazır bulunmaktadır.</p>
     </div>
    </div>

    <!-- Panel 3 -->
    <div class="ixir-ss-pane" role="tabpanel" id="ixir-ss-pane-3" aria-labelledby="ixir-ss-tab-3" hidden>
     <div class="ixir-ss-pane-card">
      <div class="ixir-ss-pane-icon">
       <i class="fas fa-network-wired" aria-hidden="true"></i>
      </div>
      <h3 class="ixir-ss-pane-title">İnternet Altyapısı</h3>
      <p class="ixir-ss-pane-desc">İnternet erişimimiz <strong>2x 10G Türknet</strong>, <strong>2x 10G Cogent</strong> ve <strong>2x 10G Comnet</strong> ISP'leriyle sağlanmaktadır, erişimler <strong>Best Path</strong> olarak ayarlanmış olup paketler en hızlı rotadan iletilmektedir, ağımız <strong>BGP yedekli</strong> olup, herhangi bir operatörde BGP anonsunun düşmesi halinde tüm trafik diğer operatörlere aktarılmakta ve yedeklilik sağlanmaktadır. Yine bu operatörler üzerinden yaptığımız gerek GRE tüneller, gerek crosconnet peering bağlantılar ile <strong>Akamai, Amazon, Microsoft, Apple, Cloudflare</strong> ağlarına erişim süreleri kısaltılmaktadır. Routerlarımız <strong>aktif/pasif fiziksel yedekli</strong> olarak ayarlanmış ve daima yedek cihazlar bulundurulmaktadır.</p>
     </div>
    </div>

    <!-- Panel 4 -->
    <div class="ixir-ss-pane" role="tabpanel" id="ixir-ss-pane-4" aria-labelledby="ixir-ss-tab-4" hidden>
     <div class="ixir-ss-pane-card">
      <div class="ixir-ss-pane-icon">
       <i class="fas fa-snowflake" aria-hidden="true"></i>
      </div>
      <h3 class="ixir-ss-pane-title">UPS ve Soğutma Sistemleri</h3>
      <p class="ixir-ss-pane-desc">UPS sistemi olarak, <strong>3 grup ile 5 farklı özellikte</strong> UPS sistemi, 5 farklı sistemde <strong>100 kVA UPS sistemine</strong> ek olarak <strong>7.5 milyon Btu/h Free Cooling Chiller</strong> soğutma sistemine ve <strong>FM 200 yangın söndürme</strong> sistemleri bulunmaktadır.</p>
     </div>
    </div>

    <!-- Panel 5 -->
    <div class="ixir-ss-pane" role="tabpanel" id="ixir-ss-pane-5" aria-labelledby="ixir-ss-tab-5" hidden>
     <div class="ixir-ss-pane-card">
      <div class="ixir-ss-pane-icon">
       <i class="fas fa-shield-alt" aria-hidden="true"></i>
      </div>
      <h3 class="ixir-ss-pane-title">Yedekli Sistemler</h3>
      <ul class="ixir-ss-pane-list">
       <li><span><strong>3 Adet</strong> Caterpillar 1100 KvA Jeneratör</span></li>
       <li><span><strong>2 Adet</strong> 3.5 Ton ve 10 Ton Yakıt Tankı</span></li>
       <li><span><strong>3 Operatörden 2x10 Gbit</strong> İnternet Bağlantısı</span></li>
       <li><span><strong>3 Farklı</strong> İnternet Servis Sağlayıcı Altyapısı</span></li>
       <li><span><strong>2.900.000 BTU/h</strong> Soğutma Sistemi</span></li>
      </ul>
     </div>
    </div>

   </div>
  </div>
 </div>

 {literal}
 <script>
  (function() {
    var section = document.querySelector('.ixir-ss-details');
    if (!section) return;

    var tabs = section.querySelectorAll('.ixir-ss-tab-btn');
    var panes = section.querySelectorAll('.ixir-ss-pane');

    tabs.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var targetId = btn.getAttribute('data-tab-target');
        if (!targetId) return;

        tabs.forEach(function(t) {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });

        panes.forEach(function(p) {
          p.classList.remove('is-active');
          p.setAttribute('hidden', '');
        });

        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');

        var activePane = section.querySelector('#ixir-ss-pane-' + targetId);
        if (activePane) {
          activePane.removeAttribute('hidden');
          // Trigger reflow for transition
          void activePane.offsetWidth;
          activePane.classList.add('is-active');
        }
      });
    });
  })();
 </script>
 {/literal}
</section>
