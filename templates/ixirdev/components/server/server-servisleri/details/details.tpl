<section class="ixir-ss-details ixir-slide ixir-slide--right is-slide-on" aria-labelledby="ixir-ss-details-title">
 <div class="container">
  <header class="ixir-wh-plans-head ixir-ss-details-head">
   <h2 id="ixir-ss-details-title">Server Destek Hizmetinin Detayları</h2>
  </header>

  <div class="ixir-ss-tab-container">
   <!-- Tab Buttons -->
   <div class="ixir-ss-tab-nav-wrapper">
    <div class="ixir-ss-tab-nav" role="tablist" aria-label="Sunucu Destek Özellikleri">
     <button type="button" class="ixir-ss-tab-btn is-active" role="tab" aria-selected="true" aria-controls="ixir-ss-pane-1" id="ixir-ss-tab-1" data-tab-target="1">
      <i class="fas fa-power-off" aria-hidden="true"></i>
      <span>Yeniden Kurulum</span>
     </button>
     <button type="button" class="ixir-ss-tab-btn" role="tab" aria-selected="false" aria-controls="ixir-ss-pane-2" id="ixir-ss-tab-2" data-tab-target="2">
      <i class="fas fa-sync-alt" aria-hidden="true"></i>
      <span>Güncelleme</span>
     </button>
     <button type="button" class="ixir-ss-tab-btn" role="tab" aria-selected="false" aria-controls="ixir-ss-pane-3" id="ixir-ss-tab-3" data-tab-target="3">
      <i class="fas fa-hourglass-half" aria-hidden="true"></i>
      <span>Bakım</span>
     </button>
     <button type="button" class="ixir-ss-tab-btn" role="tab" aria-selected="false" aria-controls="ixir-ss-pane-4" id="ixir-ss-tab-4" data-tab-target="4">
      <i class="fas fa-shield-alt" aria-hidden="true"></i>
      <span>Güvenlik Ayarları</span>
     </button>
     <button type="button" class="ixir-ss-tab-btn" role="tab" aria-selected="false" aria-controls="ixir-ss-pane-5" id="ixir-ss-tab-5" data-tab-target="5">
      <i class="fas fa-cloud-upload-alt" aria-hidden="true"></i>
      <span>Yedekleme</span>
     </button>
     <button type="button" class="ixir-ss-tab-btn" role="tab" aria-selected="false" aria-controls="ixir-ss-pane-6" id="ixir-ss-tab-6" data-tab-target="6">
      <i class="fas fa-tools" aria-hidden="true"></i>
      <span>Sorun Giderme</span>
     </button>
     <button type="button" class="ixir-ss-tab-btn" role="tab" aria-selected="false" aria-controls="ixir-ss-pane-7" id="ixir-ss-tab-7" data-tab-target="7">
      <i class="fas fa-tv" aria-hidden="true"></i>
      <span>Monitoring</span>
     </button>
    </div>
   </div>

   <!-- Tab Content Panels -->
   <div class="ixir-ss-tab-content">
    <!-- Panel 1 -->
    <div class="ixir-ss-pane is-active" role="tabpanel" id="ixir-ss-pane-1" aria-labelledby="ixir-ss-tab-1">
     <div class="ixir-ss-pane-card">
      <div class="ixir-ss-pane-icon">
       <i class="fas fa-power-off" aria-hidden="true"></i>
      </div>
      <h3 class="ixir-ss-pane-title">Sunucu Yeniden Kurulumu</h3>
      <p class="ixir-ss-pane-desc">Sunucu yeniden kurulumu özelliği ile sahip olduğunuz sunucu konfigürasyonları en baştan yeniden kurulur. Size ilk günkü gibi temiz ve sorunsuz bir sunucu sağlanır.</p>
     </div>
    </div>

    <!-- Panel 2 -->
    <div class="ixir-ss-pane" role="tabpanel" id="ixir-ss-pane-2" aria-labelledby="ixir-ss-tab-2" hidden>
     <div class="ixir-ss-pane-card">
      <div class="ixir-ss-pane-icon">
       <i class="fas fa-sync-alt" aria-hidden="true"></i>
      </div>
      <h3 class="ixir-ss-pane-title">Güncelleme</h3>
      <p class="ixir-ss-pane-desc">Sunucu güncelleme özelliği ile sahip olduğunuz sunucunun işletim sistemi, kontrol paneli ve diğer 3. parti yazılımları güncellenir ve size güncel bir sunucu sağlanır.</p>
     </div>
    </div>

    <!-- Panel 3 -->
    <div class="ixir-ss-pane" role="tabpanel" id="ixir-ss-pane-3" aria-labelledby="ixir-ss-tab-3" hidden>
     <div class="ixir-ss-pane-card">
      <div class="ixir-ss-pane-icon">
       <i class="fas fa-hourglass-half" aria-hidden="true"></i>
      </div>
      <h3 class="ixir-ss-pane-title">Bakım</h3>
      <p class="ixir-ss-pane-desc">Sunucu bakım özelliği ile sunucuz yazılımdal ve donanımsal olarak gözden geçirilir ve herhangi bir yazılım veya donanımda sorun olması durumunda müdahale edilerek sistem sürekliliği sağlanır.</p>
     </div>
    </div>

    <!-- Panel 4 -->
    <div class="ixir-ss-pane" role="tabpanel" id="ixir-ss-pane-4" aria-labelledby="ixir-ss-tab-4" hidden>
     <div class="ixir-ss-pane-card">
      <div class="ixir-ss-pane-icon">
       <i class="fas fa-shield-alt" aria-hidden="true"></i>
      </div>
      <h3 class="ixir-ss-pane-title">Güvenlik Ayarları</h3>
      <p class="ixir-ss-pane-desc">Sunucu güvenliği özelliği ile sahip olduğunuz sunucunun yazılımsal firewall konfigürasyonları yeniden gözden geçirilir, gerekirse ihtiyaca göre yeni kurallar belirlenerek, sunucu güvenliği sağlanır.</p>
     </div>
    </div>

    <!-- Panel 5 -->
    <div class="ixir-ss-pane" role="tabpanel" id="ixir-ss-pane-5" aria-labelledby="ixir-ss-tab-5" hidden>
     <div class="ixir-ss-pane-card">
      <div class="ixir-ss-pane-icon">
       <i class="fas fa-cloud-upload-alt" aria-hidden="true"></i>
      </div>
      <h3 class="ixir-ss-pane-title">Yedekleme</h3>
      <p class="ixir-ss-pane-desc">Sunucu yedekleme özelliği paketlerimizden farklı olarak verileriniz boyutu, yedekleme sıklığı ve yedekleme türüne (backup/replication) göre ayrıca projelendirilip ek bir hizmet olarak sağlanabilir, yedekleme hizmeti alınması durumunda da backup geri döndürme ücretsiz olarak sağlanacaktır.</p>
     </div>
    </div>

    <!-- Panel 6 -->
    <div class="ixir-ss-pane" role="tabpanel" id="ixir-ss-pane-6" aria-labelledby="ixir-ss-tab-6" hidden>
     <div class="ixir-ss-pane-card">
      <div class="ixir-ss-pane-icon">
       <i class="fas fa-tools" aria-hidden="true"></i>
      </div>
      <h3 class="ixir-ss-pane-title">Sorun Giderme</h3>
      <p class="ixir-ss-pane-desc">Sunucu sorun giderme özelliği ile sahip olduğunuz sunucunun üzerinde bulunan servislerin sorunsuz ve güvenli bir şekilde çalışması sağlanır.</p>
     </div>
    </div>

    <!-- Panel 7 -->
    <div class="ixir-ss-pane" role="tabpanel" id="ixir-ss-pane-7" aria-labelledby="ixir-ss-tab-7" hidden>
     <div class="ixir-ss-pane-card">
      <div class="ixir-ss-pane-icon">
       <i class="fas fa-tv" aria-hidden="true"></i>
      </div>
      <h3 class="ixir-ss-pane-title">Monitoring</h3>
      <p class="ixir-ss-pane-desc">Sunucu monitoring özelliği ile sahip olduğunuz sunucunu, IxirHost teknik destek ekibi tarafından 7/24 izlenir ve olağan dışı durumlarda anında müdahale edilir.</p>
     </div>
    </div>
   </div>
  </div>
 </div>

 <style>
  .ixir-ss-details {
    position: relative;
    padding: 85px 0 95px;
    background: #111827 url('{$WEB_ROOT}/templates/{$template}/img/server/bg8.webp') center/cover no-repeat fixed;
    overflow: hidden;
    color: #fff;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .ixir-ss-details::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.45) 0%, rgba(15, 23, 42, 0.2) 50%, rgba(15, 23, 42, 0.5) 100%);
    z-index: 0;
    pointer-events: none;
  }
  .ixir-ss-details::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 50% at 50% 35%, rgba(59, 130, 246, 0.12), transparent 70%);
    z-index: 0;
    pointer-events: none;
  }
  .ixir-ss-details .container {
    position: relative;
    z-index: 1;
  }
  .ixir-ss-details-head {
    max-width: 840px;
    margin: 0 auto 36px;
    text-align: center;
  }
  .ixir-ss-details-head h2 {
    font-family: "Space Grotesk", "Roboto", sans-serif;
    font-size: clamp(26px, 2.5vw, 36px);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin: 0;
    text-shadow: 0 4px 16px rgba(0, 0, 0, 0.6);
  }

  .ixir-ss-tab-container {
    max-width: 1320px;
    margin: 0 auto;
  }

  /* Nav Tabs */
  .ixir-ss-tab-nav-wrapper {
    position: relative;
    margin-bottom: 32px;
    padding-bottom: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .ixir-ss-tab-nav-wrapper::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }
  @media (min-width: 1024px) {
    .ixir-ss-tab-nav-wrapper {
      overflow-x: visible;
      padding-bottom: 0;
    }
  }
  .ixir-ss-tab-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: nowrap;
    gap: 6px;
    padding: 6px;
    background: rgba(15, 23, 42, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 16px;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    width: max-content;
    margin: 0 auto;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }
  .ixir-ss-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 16px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.85);
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .ixir-ss-tab-btn i {
    font-size: 13px;
    color: rgba(147, 197, 253, 0.8);
    transition: color 0.25s ease, transform 0.25s ease;
  }
  .ixir-ss-tab-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-1px);
  }
  .ixir-ss-tab-btn:hover i {
    color: #60a5fa;
  }
  .ixir-ss-tab-btn.is-active {
    color: #ffffff;
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    border-color: rgba(147, 197, 253, 0.4);
    box-shadow: 0 8px 24px -4px rgba(37, 99, 235, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.25);
    font-weight: 700;
  }
  .ixir-ss-tab-btn.is-active i {
    color: #ffffff;
  }

  /* Pane Card */
  .ixir-ss-tab-content {
    position: relative;
    min-height: 260px;
    max-width: 980px;
    margin: 0 auto;
  }
  .ixir-ss-pane {
    display: none;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .ixir-ss-pane.is-active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }
  .ixir-ss-pane-card {
    background: rgba(15, 23, 42, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 48px 40px;
    text-align: center;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    position: relative;
    overflow: hidden;
    min-height: 335px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
  }
  .ixir-ss-pane-card::before {
    content: "";
    position: absolute;
    top: -60px;
    left: 50%;
    transform: translateX(-50%);
    width: 280px;
    height: 140px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.2) 0%, transparent 70%);
    pointer-events: none;
  }
  .ixir-ss-pane-icon {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, rgba(59, 130, 246, 0.25) 0%, rgba(15, 23, 42, 0.95) 100%);
    border: 2px solid rgba(96, 165, 250, 0.35);
    box-shadow: 0 0 28px rgba(59, 130, 246, 0.3), inset 0 2px 6px rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    color: #60a5fa;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .ixir-ss-pane-card:hover .ixir-ss-pane-icon {
    transform: scale(1.05);
    border-color: rgba(96, 165, 250, 0.6);
  }
  .ixir-ss-pane-title {
    font-family: "Space Grotesk", "Roboto", sans-serif;
    font-size: 26px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
    margin: 0 0 14px;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }
  .ixir-ss-pane-desc {
    font-size: 16px;
    line-height: 1.75;
    color: #cbd5e1;
    margin: 0 auto;
    max-width: 840px;
  }

  @media (max-width: 768px) {
    .ixir-ss-details {
      padding: 60px 0 70px;
    }
    .ixir-ss-details-head {
      margin-bottom: 26px;
    }
    .ixir-ss-tab-nav {
      justify-content: flex-start;
      padding: 4px;
    }
    .ixir-ss-tab-btn {
      padding: 9px 14px;
      font-size: 13px;
    }
    .ixir-ss-pane-card {
      min-height: 350px;
      padding: 36px 20px;
      border-radius: 20px;
    }
    .ixir-ss-pane-icon {
      width: 68px;
      height: 68px;
      font-size: 26px;
      margin-bottom: 18px;
    }
    .ixir-ss-pane-title {
      font-size: 22px;
    }
    .ixir-ss-pane-desc {
      font-size: 14.5px;
      line-height: 1.65;
    }
  }
 </style>

 {literal}
 <script>
  (function() {
    var section = document.querySelector('.ixir-ss-details');
    if (!section) return;

    var tabs = section.querySelectorAll('.ixir-ss-tab-btn');
    var panes = section.querySelectorAll('.ixir-ss-pane');

    tabs.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var targetId = btn.getAttribute('data-tab-target');
        if (!targetId) return;

        tabs.forEach(function(t) {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });

        panes.forEach(function(p) {
          p.classList.remove('is-active');
          p.setAttribute('hidden', '');
        });

        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');

        var activePane = section.querySelector('#ixir-ss-pane-' + targetId);
        if (activePane) {
          activePane.removeAttribute('hidden');
          // Trigger reflow for transition
          void activePane.offsetWidth;
          activePane.classList.add('is-active');
        }
      });
    });
  })();
 </script>
 {/literal}
</section>

